# 이 파일을 복사해 `.env.local`로 만들고 값을 채우세요.
#   Windows PowerShell:  copy .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# 값은 Vercel 대시보드 → 프로젝트 → Settings → Environment Variables 에 있습니다.
# `.env.local`은 .gitignore에 있어 저장소에 올라가지 않습니다. 절대 커밋하지 마세요.

# ── 필수 ────────────────────────────────────────────────
# 없으면 앱이 죽지 않고 '데모 모드'로 동작합니다 (미리 정의된 결과 표시).
ANTHROPIC_API_KEY=

# 메일·디스코드 수집 엔드포인트를 지키는 공유 비밀.
# 없으면 수집 경로가 열리지 않고 거부됩니다 (503).
# 로컬에서 수집을 테스트하지 않는다면 아무 문자열이나 넣어도 됩니다.
INGEST_SECRET=

# ── 디스코드 ─────────────────────────────────────────────
# 봇 토큰 하나면 됩니다. 채널·요약 채널·📌 이모지는 대시보드 설정 화면에서 고릅니다.
# (봇 설정에서 Message Content Intent를 켜야 본문이 옵니다)
DISCORD_BOT_TOKEN=

# ── 저장소 (없으면 메모리에 저장 → 서버 끄면 사라짐) ──────
# Vercel의 Upstash 연동을 쓰면 KV_ 접두사로 들어옵니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 선택 ────────────────────────────────────────────────
# Vercel 크론이 보내는 인증 헤더. 로컬에서는 필요 없습니다.
CRON_SECRET=

# ── 구글 (Gmail 라벨링 · 캘린더 양방향) ─────────────────────
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션).
# 승인된 리디렉션 URI에 https://<도메인>/api/google/callback 을 넣는다.
# Gmail API, Google Calendar API 를 "사용 설정"해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 비우면 요청 도메인으로 자동 구성된다. 콘솔에 등록한 값과 다르면 여기에 그대로 적는다.
GOOGLE_REDIRECT_URI=
# 비우면 primary(기본 캘린더). 팀 공용 캘린더를 쓰려면 그 캘린더 ID.
GOOGLE_CALENDAR_ID=

# ── Gemini (메일 분류·요약. ANTHROPIC_API_KEY가 없으면 할일 추출도 이걸로) ──
# https://aistudio.google.com/apikey
#
# 0원으로 돌리려면: 이것만 넣고 ANTHROPIC_API_KEY는 비웁니다 (Claude는 무료 등급이 없습니다).
# Gemini는 Flash 계열에 무료 등급이 있습니다. 단, 무료 등급은 구글이 보낸 내용을
# 제품 개선에 쓸 수 있습니다 — 고객 메일을 넣는 도구이므로 알고 정하세요.
# 하루 호출 상한은 대시보드 설정 화면에서 겁니다 (닿으면 멈추고 다음 날 이어서 읽습니다).
GEMINI_API_KEY=
# 비우면 gemini-2.5-flash
GEMINI_MODEL=
# anthropic | gemini. 비우면 키가 있는 쪽(둘 다 있으면 anthropic)
AI_PROVIDER=

# ── 팀 접근코드 ──────────────────────────────────────────
# 세 사람이 공유하는 코드. 없으면 잠그지 않는다(로컬 개발용). 배포에서는 꼭 넣는다.
APP_PASSCODE=
